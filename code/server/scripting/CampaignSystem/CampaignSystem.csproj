<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CyberpunkSdk\CyberpunkSdk.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Default fact list, generated by tools/campaign/extract_facts.py. -->
        <EmbeddedResource Include="campaign_facts.txt" LogicalName="CampaignSystem.campaign_facts.txt"/>
        <EmbeddedResource Include="campaign_scenes.txt" LogicalName="CampaignSystem.campaign_scenes.txt"/>
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <OutputPath>..\..\..\..\build\windows\x64\debug\plugins\CampaignSystem</OutputPath>
        <PackageOutputPath>..\..\..\..\build\windows\x64\debug\plugins\CampaignSystem</PackageOutputPath>
        <NoWarn>1701;1702;3270</NoWarn>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

</Project>
